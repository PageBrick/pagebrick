<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php" colors="true" cacheDirectory=".phpunit.cache"
         failOnWarning="true" failOnNotice="true" failOnDeprecation="true">
    <php>
        <!-- error_log() lines are expected in tests (switched-off plugins, failed e-mails); keep the output clean. -->
        <ini name="error_log" value="/dev/null"/>
    </php>
    <testsuites>
        <testsuite name="core">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
